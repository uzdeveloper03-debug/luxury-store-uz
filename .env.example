# Скопируйте в .env и заполните. Файл .env НЕ коммитится в git.
# Комментарии пишите только на отдельных строках, не после значений.

# ---------- РЕЖИМ ----------
# development (по умолчанию) | test (только тестовый токен) | production (строгие проверки)
APP_ENV=development

# ---------- ОБЯЗАТЕЛЬНЫЕ ----------
# Токен бота от @BotFather, формат 123456789:AAxxxxxxxx
BOT_TOKEN=
# Минимум 32 символа. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Минимум 10 символов, не используйте простые пароли
ADMIN_PASSWORD=

# ---------- РЕКОМЕНДУЕТСЯ ----------
ADMIN_USERNAME=admin
# Адреса фронтенда (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# HTTPS-адрес Mini App (нужен боту, этап 3)
WEBAPP_URL=
# Telegram id администраторов через запятую (уведомления о заказах, этап 3)
ADMIN_TELEGRAM_IDS=

# ---------- НЕОБЯЗАТЕЛЬНЫЕ (значения по умолчанию) ----------
# SQLite по умолчанию, PostgreSQL не нужен. Относительные пути считаются от папки backend/.
# Для PostgreSQL: postgresql+psycopg://user:pass@host:5432/luxury (и pip install -r requirements-postgres.txt)
DATABASE_URL=sqlite:///./luxury.db
UPLOAD_DIR=./uploads
# Не размещайте BACKUP_DIR внутри UPLOAD_DIR: она раздаётся публично
BACKUP_DIR=./backups
BACKUP_KEEP=14
STORE_PHONE=
STORE_TELEGRAM=
STORE_ADDRESS=
# true включает /docs; в продакшене оставьте false
DEBUG=false
